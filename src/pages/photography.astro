---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
---

<BaseLayout
  title="Photography"
  description="A gallery of photographs by Michaela Barnes."
>
  <PageHeader
    kicker="Through the lens"
    title="Photography"
    lede="Photographing what moves me."
  />

  <section class="wrap gallery-section">
    <PhotoGallery />
  </section>
</BaseLayout>

<style>
  .gallery-section {
    margin-top: var(--space-xl);
  }
</style>
