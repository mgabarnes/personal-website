---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EducationCard from '../../components/EducationCard.astro';
import { publishedEducation } from '../../data/education';
---

<BaseLayout
  title="Education"
  description="Michaela Barnes's education, from Syracuse's Newhouse School to study in Strasbourg, France."
>
  <PageHeader
    kicker="Study & craft"
    title="Education"
    lede="Where the writing and the eye were trained."
  />

  <section class="wrap entry-list">
    {publishedEducation.map((item) => <EducationCard item={item} />)}
  </section>
</BaseLayout>

<style>
  .entry-list {
    margin-top: var(--space-l);
    border-bottom: 1px solid var(--color-paper-edge);
  }
</style>
