---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import { publishedExperience } from '../../data/experience';
---

<BaseLayout
  title="Experience"
  description="Michaela Barnes's professional experience across public television, education, and community consulting."
>
  <PageHeader
    kicker="Professional life"
    title="Experience"
    lede="A career across public television, the classroom, and the community."
  />

  <section class="wrap entry-list">
    {publishedExperience.map((item) => <ExperienceCard item={item} />)}
  </section>
</BaseLayout>

<style>
  .entry-list {
    margin-top: var(--space-l);
    border-bottom: 1px solid var(--color-paper-edge);
  }
</style>
