---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';

interface Props {
  entry: CollectionEntry<'writing'>;
}
const { entry } = Astro.props;
const { title, publication, publicationUrl, date, dek, externalUrl } = entry.data;

const dateLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: site.name },
  publisher: publication,
  ...(externalUrl ? { sameAs: externalUrl } : {}),
};
---

<BaseLayout
  title={title}
  description={dek ?? site.description}
  type="article"
  publishedTime={date.toISOString()}
  jsonLd={jsonLd}
>
  <article class="article wrap">
    <p class="back-link"><a href="/writing">← All writing</a></p>

    <header class="article-header">
      <p class="kicker">
        {publicationUrl ? (
          <a href={publicationUrl} target="_blank" rel="noopener noreferrer">{publication}</a>
        ) : (
          publication
        )}
        <span class="dot" aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{dateLabel}</time>
      </p>
      <h1>{title}</h1>
      {dek && <p class="article-dek">{dek}</p>}
      <hr class="rule" />
    </header>

    <div class="prose">
      <slot />
    </div>

    {externalUrl && (
      <footer class="article-footer">
        <hr class="rule" />
        <p>
          Originally published in {publication}. <a href={externalUrl} target="_blank" rel="noopener noreferrer">Read it at the source →</a>
        </p>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: var(--space-xl);
    max-width: 46rem;
  }
  .back-link {
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-l);
  }
  .article-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  .article-header .kicker {
    display: flex;
    gap: 0.5em;
    color: var(--color-ink-faint);
  }
  .article-header .dot {
    color: var(--color-paper-edge);
  }
  .article-dek {
    font-size: var(--step-1);
    color: var(--color-ink-soft);
    font-style: italic;
    line-height: 1.45;
    max-width: 52ch;
  }
  .article-header .rule {
    margin-top: var(--space-m);
  }
  .article-footer {
    margin-top: var(--space-2xl);
    color: var(--color-ink-soft);
    font-size: var(--step--1);
  }
  .article-footer .rule {
    margin-bottom: var(--space-m);
  }
</style>
